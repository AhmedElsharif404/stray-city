{
  "name": "stray-city",
  "version": "0.1.0",
  "private": true,
  "description": "Map-first New York City discovery, stories, trails, and social plans.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @stray-city/web --filter @stray-city/server dev",
    "dev:web": "pnpm --filter @stray-city/web dev",
    "dev:server": "pnpm --filter @stray-city/server dev",
    "etl:parks": "pnpm --filter @stray-city/server etl:parks",
    "etl:inspections": "pnpm --filter @stray-city/server etl:inspections",
    "etl:events": "pnpm --filter @stray-city/server etl:events",
    "etl:catalog": "pnpm --filter @stray-city/server etl:catalog",
    "etl:all": "pnpm --filter @stray-city/server etl:all",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @stray-city/shared build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter @stray-city/shared build && pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.19.0"
}
