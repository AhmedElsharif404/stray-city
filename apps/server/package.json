{
  "name": "@stray-city/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "etl:parks": "tsx src/etl/cli.ts parks",
    "etl:inspections": "tsx src/etl/cli.ts inspections",
    "etl:events": "tsx src/etl/cli.ts events",
    "etl:catalog": "tsx src/etl/cli.ts catalog",
    "etl:all": "tsx src/etl/cli.ts all",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stray-city/shared": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "pino-http": "^10.4.0",
    "spectrum-ts": "^12.10.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
